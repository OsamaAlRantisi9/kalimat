# Copy to .env.local and fill in from Firebase console → Project settings → Your apps → Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Feature flag: set to "on" to show the Listen button (browser text-to-speech).
# Off by default because browser voices mispronounce Arabic vowels.
VITE_PRONUNCIATION=
